					<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Topbar with Contact Information</title>
  <!-- Font Awesome -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
  <style>
    .topbar {
      
      color: #fff;
      padding: 10px;
      margin-right: 15px;
      display: flex;
      justify-content: flex-end;
    }

    .contact-info, .social-icons {
      display: flex;
      align-items: center;
    }

    .contact-info span {
      margin-right: 10px;
      
    }

    .social-icons a {
      color: #fff;
      margin-left: 10px;
      text-decoration: none;
    }

    .social-icons a:hover {
      color: #ffd700; /* Change color on hover */
    }

    /* Media Queries for Responsive Design */
    @media only screen and (max-width: 768px) {
      .topbar {
        flex-direction: column;
        align-items: flex-start;
      }

      .contact-info, .social-icons {
        margin-top: 10px;
        
      }

      .contact-info span {
        display: block;
        margin-bottom: 5px;
        margin-right: 15;
      }

      .social-icons a {
        margin-left: 0;
        margin-right: 10px;
      }

      .contact-info span:last-child {
        padding-right: 10px;
      }
    }
  </style>
</head>
<body>

<div class="topbar">
  <div class="contact-info">
    <span><i class="fas fa-mobile-alt"></i> 0800 888 66</span>
    <span><i class="fas fa-envelope"></i> <a href="/cdn-cgi/l/email-protection" class="__cf_email__" data-cfemail="87eee9e1e8c7e9e6f1f3f3e4a9e0e8f1a9f7ec">[email&#160;protected]</a></span>
  </div>
  <div class="social-icons">
    <a href="https://www.facebook.com/NAVTTCOfficial/"><i class="fab fa-facebook"></i></a>
    <a href="https://www.twitter.com/NAVTTCOfficial/"><i class="fab fa-x-twitter"></i></a>
    <a href="https://www.youtube.com/NAVTTCOfficial/"><i class="fab fa-youtube"></i></a>
    <a href="https://www.instagram.com/navttcofficial/"><i class="fab fa-instagram"></i></a>
    <a href="https://pk.linkedin.com/company/navttcofficial/"><i class="fab fa-linkedin"></i></a>
  </div>
</div>

<header>
